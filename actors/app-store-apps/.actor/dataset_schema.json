      },
      "privacyPolicyUrl": {
        "type": ["string", "null"],
        "title": "Privacy policy",
        "description": "Google Play privacy policy URL (app details).",
        "example": "https://www.spotify.com/legal/privacy-policy/"
      },
      "country": {
        "type": ["string", "null"],
        "title": "Country",
        "description": "Store country code.",
        "example": "us"
      },
      "language": {
        "type": ["string", "null"],
        "title": "Language",
        "description": "Google Play display language; null for the App Store.",
