        "example": "Jane Q Doe"
      },
      "registeredAgentAddress": {
        "type": ["object", "null"],
        "title": "Agent address",
        "description": "Registered agent address: street, street2, city, state, zip, country.",
        "example": {
          "street": "1600 Broadway",
          "street2": null,
          "city": "Denver",
          "state": "CO",
          "zip": "80202",
          "country": "US"
        }
      },
      "sourceUrl": {
        "type": ["string", "null"],
        "title": "Source",
        "description": "Link to the record in the state's open-data portal.",
