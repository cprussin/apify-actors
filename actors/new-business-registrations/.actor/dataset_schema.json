    "properties": {
      "state": {
        "type": ["string", "null"],
        "title": "State",
        "description": "US state code of the registry.",
        "example": "CO"
      },
      "entityId": {
        "type": ["string", "null"],
        "title": "Entity ID",
        "description": "State registry entity ID.",
        "example": "20261234567"
      },
      "name": {
        "type": ["string", "null"],
        "title": "Business name",
        "description": "Registered business name.",
        "example": "Mile High Roofing LLC"
      },
      "entityType": {
        "type": ["string", "null"],
        "title": "Entity type",
        "description": "Entity type as the state labels it.",
        "example": "DLLC"
      },
      "entityCategory": {
        "type": ["string", "null"],
        "title": "Category",
        "description": "Normalized entity category, e.g. llc or corporation.",
        "example": "llc"
      },
      "status": {
        "type": ["string", "null"],
        "title": "Status",
        "description": "Entity status as reported by the state.",
        "example": "Good Standing"
      },
      "formationDate": {
        "type": ["string", "null"],
        "title": "Formed",
        "description": "Formation or registration date (YYYY-MM-DD).",
        "example": "2026-09-25"
      },
      "jurisdiction": {
        "type": ["string", "null"],
        "title": "Jurisdiction",
        "description": "State or country of formation.",
        "example": "CO"
      },
      "county": {
        "type": ["string", "null"],
        "title": "County",
        "description": "County, where the state publishes it.",
        "example": "DENVER"
      },
      "principalAddress": {
        "type": ["object", "null"],
        "title": "Principal address",
