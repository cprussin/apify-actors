          "street": "1600 Broadway",
          "street2": "Suite 200",
          "city": "Denver",
          "state": "CO",
          "zip": "80202",
          "country": "US"
        }
      },
      "mailingAddress": {
        "type": ["object", "null"],
        "title": "Mailing address",
        "description": "Mailing address: street, street2, city, state, zip, country.",
        "example": {
          "street": "PO Box 123",
          "street2": null,
          "city": "Denver",
          "state": "CO",
          "zip": "80201",
          "country": "US"
        }
      },
      "registeredAgentName": {
        "type": ["string", "null"],
        "title": "Registered agent",
