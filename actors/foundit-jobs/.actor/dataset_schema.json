      },
      "searchLocation": {
        "type": ["string", "null"],
        "title": "Search location",
        "description": "Location filter of the search that found the job.",
        "example": "Bangalore"
      },
      "scrapedAt": {
        "type": ["string", "null"],
        "title": "Scraped at",
        "description": "When the job was scraped (ISO 8601 UTC).",
        "example": "2026-10-03T00:00:00.000Z"
      }
