      },
      "tournamentCountry": {
        "type": ["string", "null"],
        "title": "Tournament country",
        "description": "Tournament country code.",
        "example": "CN"
      },
      "tour": {
        "type": ["string", "null"],
        "title": "Tour",
        "description": "Tour, e.g. ATP, WTA, CHALLENGER, ITF_MEN.",
