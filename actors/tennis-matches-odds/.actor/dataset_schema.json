{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "matchId": {
        "type": ["string", "null"],
        "title": "Match ID",
        "description": "TennisExplorer match ID.",
        "example": "3334240"
      },
      "date": {
        "type": ["string", "null"],
        "title": "Date",
        "description": "Match date (YYYY-MM-DD, Central European time).",
        "example": "2026-09-28"
      },
      "time": {
        "type": ["string", "null"],
        "title": "Time (CET)",
        "description": "Start time (HH:MM, Central European time), when shown.",
        "example": "13:25"
      },
      "tournament": {
        "type": ["string", "null"],
        "title": "Tournament",
        "description": "Tournament name.",
        "example": "Chengdu"
      },
      "tournamentUrl": {
        "type": ["string", "null"],
        "title": "Tournament URL",
        "description": "Tournament page on TennisExplorer.",
        "example": "https://www.tennisexplorer.com/chengdu/2026/atp-men/"
      },
      "tournamentCountry": {
        "type": ["string", "null"],
        "title": "Tournament country",
        "description": "Tournament country code.",
        "example": "CN"
      },
      "tour": {
        "type": ["string", "null"],
        "title": "Tour",
        "description": "Tour, e.g. ATP, WTA, CHALLENGER, ITF_MEN, ATP_DOUBLES.",
        "example": "ATP"
      },
      "surface": {
        "type": ["string", "null"],
        "title": "Surface",
        "description": "Court surface, e.g. hard, clay or grass.",
        "example": "hard"
      },
      "round": {
        "type": ["string", "null"],
        "title": "Round",
        "description": "Round, e.g. 1R, QF, SF, F, Q-1R.",
        "example": "SF"
      },
      "player1": {
        "type": ["object", "null"],
        "title": "Player 1",
        "description": "First-listed player: name, slug, country, seed, rank. Doubles results: the team as listed; upcoming doubles: null (see team1).",
        "example": {
          "name": "Hurkacz Hubert",
          "slug": "hurkacz",
          "country": null,
          "seed": "5",
          "rank": 41
        }
      },
      "player2": {
        "type": ["object", "null"],
        "title": "Player 2",
        "description": "Second-listed player: name, slug, country, seed, rank.",
        "example": {
          "name": "Shapovalov Denis",
          "slug": "shapovalov",
          "country": null,
          "seed": "7",
          "rank": 46
        }
      },
      "winner": {
        "type": ["string", "null"],
        "title": "Winner side",
        "description": "player1 or player2.",
        "example": "player1"
      },
      "winnerName": {
        "type": ["string", "null"],
        "title": "Winner",
        "description": "Winner's name.",
        "example": "Hurkacz Hubert"
      },
      "setsPlayer1": {
        "type": ["number", "null"],
        "title": "Sets P1",
        "description": "Sets won by player1.",
        "example": 2
      },
      "setsPlayer2": {
        "type": ["number", "null"],
        "title": "Sets P2",
        "description": "Sets won by player2.",
        "example": 1
      },
      "setScores": {
        "type": ["array", "null"],
        "title": "Set scores",
        "description": "Games per set: player1, player2, tiebreak (loser's tiebreak points).",
        "example": [
          {
            "player1": 6,
            "player2": 7,
            "tiebreak": 8
          },
          {
            "player1": 6,
            "player2": 3,
            "tiebreak": null
          },
          {
            "player1": 6,
            "player2": 3,
            "tiebreak": null
          }
        ]
      },
      "score": {
        "type": ["string", "null"],
        "title": "Score",
        "description": "Score from player1's view, e.g. 6-7(8) 6-3 6-3.",
        "example": "6-7(8) 6-3 6-3"
      },
      "status": {
        "type": ["string", "null"],
        "title": "Status",
        "description": "Results: completed, retired or walkover. Upcoming: scheduled.",
        "example": "completed"
      },
      "state": {
        "type": ["string", "null"],
        "title": "State",
        "description": "finished (results mode) or scheduled (upcoming mode).",
        "example": "finished"
      },
      "team1": {
        "type": ["array", "null"],
        "title": "Team 1",
        "description": "Doubles only: the two players of side 1 (name, slug, rank); null for singles. In results, player1 then holds the team as listed.",
        "example": [
          {
            "name": "Falck R.",
            "slug": "falck",
            "country": null,
            "seed": null,
            "rank": null
          },
          {
            "name": "Suarez B.",
            "slug": "suarez-e2086",
            "country": null,
            "seed": null,
            "rank": null
          }
        ]
      },
      "team2": {
        "type": ["array", "null"],
        "title": "Team 2",
        "description": "Doubles only: the two players of side 2; null for singles.",
        "example": [
          {
            "name": "Santillan A.",
            "slug": "santillan-29bed",
            "country": null,
            "seed": null,
            "rank": null
          },
          {
            "name": "Zheng B.",
            "slug": "zheng-642ed",
            "country": null,
            "seed": null,
            "rank": null
          }
        ]
      },
      "scheduledDate": {
        "type": ["string", "null"],
        "title": "Scheduled date",
        "description": "Upcoming mode: match day (YYYY-MM-DD, TennisExplorer's Central European day).",
        "example": "2026-11-26"
      },
      "startTime": {
        "type": ["string", "null"],
        "title": "Start time",
        "description": "Upcoming mode: start time as shown (HH:MM in timeZone); null while not set.",
        "example": "14:00"
      },
      "timeZone": {
        "type": ["string", "null"],
        "title": "Time zone",
        "description": "Upcoming mode: time zone of scheduledDate and startTime as shown by TennisExplorer (GMT+1 in winter, GMT+2 in summer).",
        "example": "GMT+1"
      },
      "seed1": {
        "type": ["string", "null"],
        "title": "Seed 1",
        "description": "Upcoming mode: seed or entry label of side 1 (5, Q, WC, LL...).",
        "example": null
      },
      "seed2": {
        "type": ["string", "null"],
        "title": "Seed 2",
        "description": "Upcoming mode: seed or entry label of side 2.",
        "example": "6"
      },
      "bookmakers": {
        "type": ["array", "null"],
        "title": "Bookmakers",
        "description": "Upcoming mode with includeBookmakerOdds: per-bookmaker pre-match odds: name, home, away (current), openingHome, openingAway.",
        "example": [
          {
            "name": "bet365",
            "home": 3.2,
            "away": 1.33,
            "openingHome": 3,
            "openingAway": 1.36
          },
          {
            "name": "Pinnacle",
            "home": 3.24,
            "away": 1.37,
            "openingHome": 3.1,
            "openingAway": 1.39
          }
        ]
      },
      "sourceUrl": {
        "type": ["string", "null"],
        "title": "Source URL",
        "description": "Upcoming mode: match page on TennisExplorer.",
        "example": "https://www.tennisexplorer.com/match-detail/?id=3388457"
      },
      "oddsHome": {
        "type": ["number", "null"],
        "title": "Odds P1",
        "description": "Decimal odds for player1 / side 1 (TennisExplorer average): closing odds in results, current pre-match odds in upcoming mode.",
        "example": 1.61
      },
      "oddsAway": {
        "type": ["number", "null"],
        "title": "Odds P2",
        "description": "Decimal odds for player2 / side 2 (TennisExplorer average): closing odds in results, current pre-match odds in upcoming mode.",
        "example": 2.29
      },
      "bookmakerOdds": {
        "type": ["array", "null"],
        "title": "Bookmaker odds",
        "description": "Per-bookmaker odds (only with includeBookmakerOdds): bookmaker, oddsHome, oddsAway, openingOddsHome, openingOddsAway.",
        "example": [
          {
            "bookmaker": "bet-at-home",
            "oddsHome": 1.58,
            "oddsAway": 2.25,
            "openingOddsHome": 1.55,
            "openingOddsAway": 2.3
          },
          {
            "bookmaker": "Pinnacle",
            "oddsHome": 1.66,
            "oddsAway": 2.37,
            "openingOddsHome": 1.77,
            "openingOddsAway": 2.16
          }
        ]
      },
      "url": {
        "type": ["string", "null"],
        "title": "URL",
        "description": "Match page on TennisExplorer.",
        "example": "https://www.tennisexplorer.com/match-detail/?id=3334240"
      }
    }
  },
