      },
      "date": {
        "type": ["string", "null"],
        "title": "Date",
        "description": "Match date (YYYY-MM-DD, Central European time).",
        "example": "2026-09-28"
      },
      "time": {
        "type": ["string", "null"],
        "title": "Time (CET)",
        "description": "Start time (HH:MM, Central European time), when shown.",
        "example": "13:25"
      },
      "tournament": {
        "type": ["string", "null"],
        "title": "Tournament",
        "description": "Tournament name.",
        "example": "Chengdu"
      },
      "tournamentUrl": {
        "type": ["string", "null"],
        "title": "Tournament URL",
        "description": "Tournament page on TennisExplorer.",
