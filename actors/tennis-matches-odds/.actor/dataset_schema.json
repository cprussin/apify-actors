      },
      "player1": {
        "type": ["object", "null"],
        "title": "Player 1",
        "description": "First-listed player: name, slug, country, seed, rank.",
        "example": {
          "name": "Hurkacz Hubert",
          "slug": "hurkacz",
          "country": null,
          "seed": "5",
          "rank": 41
        }
      },
      "player2": {
        "type": ["object", "null"],
        "title": "Player 2",
        "description": "Second-listed player: name, slug, country, seed, rank.",
        "example": {
          "name": "Shapovalov Denis",
          "slug": "shapovalov",
          "country": null,
          "seed": "7",
          "rank": 46
        }
      },
      "winner": {
        "type": ["string", "null"],
        "title": "Winner side",
        "description": "player1 or player2.",
        "example": "player1"
      },
      "winnerName": {
        "type": ["string", "null"],
        "title": "Winner",
        "description": "Winner's name.",
        "example": "Hurkacz Hubert"
      },
      "setsPlayer1": {
        "type": ["number", "null"],
        "title": "Sets P1",
        "description": "Sets won by player1.",
        "example": 2
      },
      "setsPlayer2": {
        "type": ["number", "null"],
        "title": "Sets P2",
        "description": "Sets won by player2.",
        "example": 1
      },
      "setScores": {
        "type": ["array", "null"],
        "title": "Set scores",
        "description": "Games per set: player1, player2, tiebreak (loser's tiebreak points).",
        "example": [
          {
            "player1": 6,
            "player2": 7,
            "tiebreak": 8
          },
          {
            "player1": 6,
            "player2": 3,
            "tiebreak": null
          },
          {
            "player1": 6,
            "player2": 3,
            "tiebreak": null
          }
        ]
      },
      "score": {
        "type": ["string", "null"],
        "title": "Score",
        "description": "Score from player1's view, e.g. 6-7(8) 6-3 6-3.",
        "example": "6-7(8) 6-3 6-3"
      },
      "status": {
        "type": ["string", "null"],
        "title": "Status",
        "description": "completed, retired or walkover.",
        "example": "completed"
      },
      "oddsHome": {
        "type": ["number", "null"],
        "title": "Odds P1",
        "description": "Closing decimal odds for player1 (TennisExplorer average).",
        "example": 1.61
      },
      "oddsAway": {
        "type": ["number", "null"],
        "title": "Odds P2",
        "description": "Closing decimal odds for player2 (TennisExplorer average).",
        "example": 2.29
      },
      "bookmakerOdds": {
        "type": ["array", "null"],
        "title": "Bookmaker odds",
        "description": "Per-bookmaker odds (only with includeBookmakerOdds): bookmaker, oddsHome, oddsAway, openingOddsHome, openingOddsAway.",
        "example": [
          {
            "bookmaker": "bet-at-home",
            "oddsHome": 1.58,
            "oddsAway": 2.25,
            "openingOddsHome": 1.55,
            "openingOddsAway": 2.3
          },
          {
            "bookmaker": "Pinnacle",
            "oddsHome": 1.66,
            "oddsAway": 2.37,
            "openingOddsHome": 1.77,
            "openingOddsAway": 2.16
          }
        ]
      },
      "url": {
        "type": ["string", "null"],
        "title": "URL",
        "description": "Match page on TennisExplorer.",
        "example": "https://www.tennisexplorer.com/match-detail/?id=3334240"
      }
    }
