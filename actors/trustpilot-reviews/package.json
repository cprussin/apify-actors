{
  "name": "trustpilot-reviews",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trustpilot company reviews and company profile (TrustScore, review counts) as clean JSON.",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "apify": "^3.7.2",
    "playwright": "1.56.1",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
