            "format": "text"
          },
          "isOnline": {
            "label": "Online",
            "format": "boolean"
          },
          "isFree": {
            "label": "Free",
            "format": "boolean"
          },
          "priceMin": {
            "label": "Price min",
            "format": "number"
          },
          "priceMax": {
            "label": "Price max",
            "format": "number"
          },
          "currency": {
            "label": "Currency",
            "format": "text"
          },
          "guestCount": {
            "label": "Guests",
            "format": "number"
          },
          "hostNames": {
            "label": "Hosts",
            "format": "array"
          },
          "calendarName": {
            "label": "Calendar",
