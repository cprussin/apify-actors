{
  "name": "google-ads-transparency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Google Ads Transparency Center scraper: ads by advertiser name, ID or domain, with ad copy, images, videos and dates.",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "apify": "^3.7.2",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
